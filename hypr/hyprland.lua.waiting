--############################

--## ENVIRONMENT VARIABLES ###

--############################

-- See https://wiki.hyprland.org/Configuring/Environment-variables/

hl.env("XCURSOR_SIZE", 24)

hl.env("HYPRCURSOR_SIZE", 24)

--####################

--## LOOK AND FEEL ###

--####################

-- Refer to https://wiki.hyprland.org/Configuring/Variables/

-- https://wiki.hyprland.org/Configuring/Variables/#general

hl.config({
    general = {
        gaps_in = 4,
        gaps_out = 4,
        border_size = 2,
        -- https://wiki.hyprland.org/Configuring/Variables/#variable-types for info about colors
        -- Set to true enable resizing windows by clicking and dragging on borders and gaps
        resize_on_border = false,
        -- Please see https://wiki.hyprland.org/Configuring/Tearing/ before you turn this on
        allow_tearing = true,
        layout = "master",
        col = {
            active_border = { colors = { "rgba(33ccffee)", "rgba(00ff99ee)" }, angle = 45 },
            inactive_border = "rgba(595959aa)",
        },
    },
})

hl.config({
    render = {
        --new_render_scheduling = false
        --direct_scanout = false
    },
})

hl.config({
    master = {
        mfact = 0.5,
        new_status = "slave",
    },
})

-- https://wiki.hyprland.org/Configuring/Variables/#decoration

hl.config({
    decoration = {
        rounding = 2,
        -- Change transparency of focused and unfocused windows
        active_opacity = 1.0,
        inactive_opacity = 1.0,
        -- https://wiki.hyprland.org/Configuring/Variables/#blur
        blur = {
            enabled = false,
            size = 3,
            passes = 1,
            vibrancy = 0.1696,
        },
    },
})

-- https://wiki.hyprland.org/Configuring/Variables/#animations

hl.config({
    animations = {
        enabled = false,
        -- Default animations, see https://wiki.hyprland.org/Configuring/Animations/ for more
    },
})

-- See https://wiki.hyprland.org/Configuring/Master-Layout/ for more

hl.config({
    master = {
        new_status = "master",
    },
})

-- https://wiki.hyprland.org/Configuring/Variables/#misc

hl.config({
    misc = {
        force_default_wallpaper = -1,
        -- Set to 0 or 1 to disable the anime mascot wallpapers
        disable_hyprland_logo = false,
        -- If true disables the random hyprland logo / anime girl background. :(
        focus_on_activate = false,
        --do not switch workspaces when starting programs
        --vfr = true
        --vrr = false
    },
})

--############

--## INPUT ###

--############

-- https://wiki.hyprland.org/Configuring/Variables/#input

hl.config({
    input = {
        kb_layout = "us",
        -- kb_variant = {  },
        -- kb_model = {  },
        --kb_options = caps:none, altwin:swap_alt_win
        -- kb_rules = {  },
        follow_mouse = 1,
        touchpad = {
            natural_scroll = false,
        },
        accel_profile = "flat",
        sensitivity = -0.75,
    },
})

-- See https://wiki.hyprland.org/Configuring/Keywords/#per-device-input-configs for more

hl.device({
    name = "epic-mouse-v1",
    sensitivity = -0.5,
})

--###################

--## KEYBINDINGSS ###

--###################

-- See https://wiki.hyprland.org/Configuring/Keywords/

--$mainMod = Mod1

local mainMod = "SUPER"

-- Sets "Windows" key as main modifier

-- Example binds, see https://wiki.hyprland.org/Configuring/Binds/ for more

hl.bind(mainMod .. " + " .. "RETURN", hl.dsp.exec_cmd("alacritty msg create-window || exec alacritty"))

hl.bind(mainMod .. " + " .. "G", hl.dsp.exec_cmd("browser"))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "G", hl.dsp.exec_cmd("browser -incognito"))

hl.bind(mainMod .. " + " .. "S", hl.dsp.exec_cmd("flameshot gui"))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "C", hl.dsp.window.close())

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "Q", hl.dsp.exit())

--bind = $mainMod, E, exec, $fileManager

hl.bind(mainMod .. " + " .. "F", hl.dsp.window.float())

hl.bind(mainMod .. " + " .. "P", hl.dsp.exec_cmd("dmenu_run -b"))

--##windows

--doesn't work properly with master layout after window reordering

--bind = $mainMod, J, cyclenext

--bind = $mainMod, K, cyclenext,prev

--master

hl.bind(mainMod .. " + " .. "J", hl.dsp.layout("cyclenext"))

hl.bind(mainMod .. " + " .. "K", hl.dsp.layout("cycleprev"))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "J", hl.dsp.layout("swapnext"))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "K", hl.dsp.layout("swapprev"))

--scrolling
-- hl.bind(mainMod .. " + " .. "J", hl.dsp.layout("focus left"))
-- hl.bind(mainMod .. " + " .. "K", hl.dsp.layout("focus right"))
-- hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "J", hl.dsp.layout("swapcol l"))
-- hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "K", hl.dsp.layout("swapcol r"))
-- Move/resize windows with mainMod + LMB/RMB and dragging

hl.bind(mainMod .. " + " .. "mouse:272", hl.dsp.window.drag(), { mouse = true })

hl.bind(mainMod .. " + " .. "mouse:273", hl.dsp.window.resize(), { mouse = true })

--bind = $mainMod, L, resizeactive, 100 0

--bind = $mainMod, H, resizeactive, -100 0

hl.bind(mainMod .. " + " .. "L", hl.dsp.layout("mfact +0.1"))

hl.bind(mainMod .. " + " .. "H", hl.dsp.layout("mfact -0.1"))

hl.bind(mainMod .. " + " .. "i", hl.dsp.layout("addmaster"))

hl.bind(mainMod .. " + " .. "d", hl.dsp.layout("removemaster"))

--##workspaces

-- Switch workspaces with mainMod + [0-9]

hl.bind(mainMod .. " + " .. 1, hl.dsp.focus({ workspace = 1 }))

hl.bind(mainMod .. " + " .. 2, hl.dsp.focus({ workspace = 2 }))

hl.bind(mainMod .. " + " .. 3, hl.dsp.focus({ workspace = 3 }))

hl.bind(mainMod .. " + " .. 4, hl.dsp.focus({ workspace = 4 }))

hl.bind(mainMod .. " + " .. 5, hl.dsp.focus({ workspace = 5 }))

hl.bind(mainMod .. " + " .. 6, hl.dsp.focus({ workspace = 6 }))

hl.bind(mainMod .. " + " .. 7, hl.dsp.focus({ workspace = 7 }))

hl.bind(mainMod .. " + " .. 8, hl.dsp.focus({ workspace = 8 }))

hl.bind(mainMod .. " + " .. 9, hl.dsp.focus({ workspace = 9 }))

hl.bind(mainMod .. " + " .. 0, hl.dsp.focus({ workspace = 10 }))

-- Move active window to a workspace with mainMod + SHIFT + [0-9]

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 1, hl.dsp.window.move({ workspace = 1 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 2, hl.dsp.window.move({ workspace = 2 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 3, hl.dsp.window.move({ workspace = 3 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 4, hl.dsp.window.move({ workspace = 4 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 5, hl.dsp.window.move({ workspace = 5 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 6, hl.dsp.window.move({ workspace = 6 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 7, hl.dsp.window.move({ workspace = 7 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 8, hl.dsp.window.move({ workspace = 8 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 9, hl.dsp.window.move({ workspace = 9 }, { follow = false }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. 0, hl.dsp.window.move({ workspace = 10 }, { follow = false }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 1, hl.dsp.window.move({ workspace = 1 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 2, hl.dsp.window.move({ workspace = 2 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 3, hl.dsp.window.move({ workspace = 3 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 4, hl.dsp.window.move({ workspace = 4 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 5, hl.dsp.window.move({ workspace = 5 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 6, hl.dsp.window.move({ workspace = 6 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 7, hl.dsp.window.move({ workspace = 7 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 8, hl.dsp.window.move({ workspace = 8 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 9, hl.dsp.window.move({ workspace = 9 }))

hl.bind(mainMod .. " + " .. "CONTROL + SHIFT" .. " + " .. 0, hl.dsp.window.move({ workspace = 10 }))

--review
-- hl.bind(mainMod .. " + " .. "M", hl.dsp.window.fullscreen_state(1))

--reset workspace

--##also crashes hyprland if there is a floating window

--bind = $mainMod, R, exec, hyprctl keyword general:layout scrolling

hl.bind(mainMod .. " + " .. "R", hl.dsp.exec_cmd("hyprctl keyword general:layout master"))

hl.bind(mainMod .. " + " .. "R", hl.dsp.layout("focusmaster master"))

hl.bind(mainMod .. " + " .. "R", hl.dsp.layout("mfact exact . 5"))

--##for some reason this crashes hyprland by running repeatedly

--bind = $mainMod, R, togglefloating,

--set back to normal tiling

hl.bind(mainMod .. " + " .. "T", hl.dsp.layout("orientationleft"))

--set to bottom tiling

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "T", hl.dsp.layout("orientationbottom"))

--#dwindle

--bind = $mainMod CONTROL, T, exec, hyprctl keyword general:layout dwindle

--bind = $mainMod, D, pseudo, # dwindle

--bind = $mainMod, J, togglesplit, # dwindle

--bind = $mainMod CONTROL, T, layoutmsg, preserve_split true

hl.bind(mainMod .. " + " .. "space", hl.dsp.exec_cmd("hyprctl keyword general:layout $(hyprctl getoption general:layout | grep -q 'scrolling' && echo 'master' || echo 'scrolling')"))

--! @description: "Toggle between scrolling and master layout"; @windows;

-- Example special workspace (scratchpad)

--bind = $mainMod, S, togglespecialworkspace, magic

--bind = $mainMod SHIFT, S, movetoworkspace, special:magic

-- Scroll through existing workspaces with mainMod + scroll

hl.bind(mainMod .. " + " .. "mouse_down", hl.dsp.focus({ workspace = "e+1" }))

hl.bind(mainMod .. " + " .. "mouse_up", hl.dsp.focus({ workspace = "e-1" }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "L", hl.dsp.focus({ workspace = "e+1" }))

hl.bind(mainMod .. " + " .. "SHIFT" .. " + " .. "H", hl.dsp.focus({ workspace = "e-1" }))

hl.bind(mainMod .. " + " .. "CONTROL" .. " + " .. "L", hl.dsp.focus({ workspace = "+1" }))

hl.bind(mainMod .. " + " .. "CONTROL" .. " + " .. "H", hl.dsp.focus({ workspace = -1 }))

--switch between two workspaces

hl.config({
    binds = {
        allow_workspace_cycles = true,
    },
})

hl.bind(mainMod .. " + " .. "TAB", hl.dsp.focus({ workspace = "previous" }))

--#############################

--## WINDOWS AND WORKSPACES ###

--#############################

-- See https://wiki.hyprland.org/Configuring/Window-Rules/ for more

-- See https://wiki.hyprland.org/Configuring/Workspace-Rules/ for workspace rules

-- Example windowrule v1

-- windowrule = float, ^(kitty)$

--disable vsync for games

hl.window_rule({
    name  = "match_class_____ez_q",
    match = {
class =           "^(.*ez[Qq]uake.*)$",
class =           "^(.*zdoom.*)$",
class =           "^([Ss]team.*)$",
class =           "^(.*[Ss]nes9x.*)$",
class =           "^[Mm]mame$"
-- class =           ".*[Mm]ednafen.*$",
    },
    immediate = true
})


-- hl.window_rule({
--     name  = "match_class___xephyr",
--     match = {
--         class = "maximize 1",
--     },
--     -- TODO: review rule: "match:class ^(Xephyr)$"
-- })

hl.window_rule({
    name  = "match_title_____cssh",
    match = {
        title = "^(.*CSSH.*)$",
        title = "^(annotate_toolbar)$",
        class = "^(zoom)$"
    },
    no_initial_focus = true
})

hl.window_rule({
    name  = "workspace_5_silent",
    match = {
        class = "^([Ss]team)$",
    },
    workspace = "5 silent",
})

hl.window_rule({
    name  = "workspace_6_silent",
    match = {
        class = "^(.*Slack)$",
    },
    workspace = "6 silent",
})

hl.window_rule({
    name  = "workspace_7_silent",
    match = {
        class = "^(.*discord.*)$",
    },
    workspace = "7 silent",
})

hl.window_rule({
    name  = "workspace_8_silent",
    match = {
        class = "^(Hexchat)$",
    },
    workspace = "8 silent",
})

hl.window_rule({
    name  = "workspace_9_silent",
    match = {
        class = "^(chrome-music.*)$",
    },
    workspace = "9 silent",
})

--no_gaps_when_only client

hl.workspace_rule({
    workspace = "w[t1]",
    gaps_out = 0,
    gaps_in = 0,
    border_size = 0,
    -- rounding = false,
})

hl.workspace_rule({
    workspace = "f[1]",
    gaps_out = 0,
    gaps_in = 0,
    border_size = 0,
    -- rounding = false,
})

--environment

hl.env("SDL_VIDEODRIVER", "wayland")

hl.env("SDL_AUDIODRIVER", "pipewire")

--##flatpak qt applications don't always have this backend

--env = QT_QPA_PLATFORM,wayland

--#autostart






--exec-once = cmst -m





--exec-once = pasystray

--exec-once = [workspace 1 silent] $terminal

--exec-once = wl-paste -t text --watch clipman store --no-persist

-- Autostart
hl.on("hyprland.start", function()
    hl.exec_cmd("waybar &")
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("[workspace 7 silent] discord")
    hl.exec_cmd("[workspace 8 silent] hexchat")
    hl.exec_cmd("[workspace 9 silent] youtube-music")
    hl.exec_cmd("nagstamon")
    hl.exec_cmd("easyeffects -w")
    hl.exec_cmd("dunst")
    hl.exec_cmd("alacritty --daemon")
    hl.exec_cmd("local_var_HOME/bin/amdclocks")
end)
